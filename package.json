{
  "name": "esther",
  "version": "0.1.0",
  "description": "Event sourcing framework built on Dynamic Consistency Boundaries",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/adapters/browser/index.ts",
    "./cli": "./src/adapters/cli/index.ts",
    "./postgres": "./src/adapters/postgres/index.ts",
    "./filesystem": "./src/adapters/filesystem/index.ts",
    "./fastify": "./src/adapters/fastify/index.ts",
    "./test": "./src/adapters/in-memory/index.ts",
    "./react": "./src/adapters/react/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "bun run lint:code && bun run lint:deps",
    "lint:code": "eslint src --max-warnings=0",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "lint:fix": "eslint src --fix",
    "format": "biome format src/ --write",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target node"
  },
  "dependencies": {
    "neverthrow": "^8.1.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260417.1",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "fastify": "^5.8.4",
    "happy-dom": "15.11.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "fastify": "^5.8.4",
    "postgres": "^3.4.5",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
