{
  "name": "esther",
  "version": "0.1.0",
  "description": "Event sourcing framework built on Dynamic Consistency Boundaries",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/adapters/postgres/index.ts",
    "./http": "./src/adapters/http/index.ts",
    "./test": "./src/adapters/in-memory/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target node"
  },
  "dependencies": {
    "neverthrow": "^8.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "postgres": "^3.4.5"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  }
}
